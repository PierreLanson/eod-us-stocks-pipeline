# .gitignore — files and folders Git should NEVER track.

# --- Secrets -------------------------------------------------------------
# Your real passwords and API keys live in .env. Never commit it.
# (.env.example IS committed — it's the template with no real values.)
.env

# --- Data ----------------------------------------------------------------
# Raw API responses. Data belongs in the database, not in Git.
data/

# --- Python --------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc

# --- dbt -----------------------------------------------------------------
# Generated each time dbt runs; rebuildable, so not tracked.
dbt/**/target/
dbt/**/dbt_packages/
dbt/**/logs/
logs/

# --- OS / editor clutter -------------------------------------------------
.DS_Store
.vscode/
