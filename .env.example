# Template for your local .env file.
# Copy it with:   cp .env.example .env
# then fill in real values in .env (which Git ignores).

# --- Postgres (used by Docker to create the database, and by our Python/dbt to connect) ---
POSTGRES_USER=stocks
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stocks
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- APIs (needed from the ingest step onwards) ---
# Free key from https://massive.com
MASSIVE_API_KEY=
# The SEC requires every request to identify you: "Your Name your-email@example.com"
SEC_USER_AGENT=
